---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PopText from "../components/PopText.astro";
import { automation, automationDecisions, automationMetrics, education, experience, projects, skills } from "../data/portfolio.js";
import pipelineArticles from "../data/pipelineArticles.json";
import profileImage from "../assets/personal/profile.jpg";
import nimbusPoster from "../assets/projects/dev/Nimbus_img1.png";

const base = import.meta.env.BASE_URL;
const imageDimensions = (image, maxWidth = image.width) => {
  const width = Math.min(image.width, maxWidth);
  return { width, height: Math.round(image.height * (width / image.width)) };
};
---

<BaseLayout title="Gene Harold Cinto | Portfolio">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <nav class="nav-shell" aria-label="Main navigation">
      <a class="wordmark" href={`${base}`} aria-label="Gene Harold Cinto, home">Gene<span>.</span></a>
      <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-navigation" data-menu-toggle>
        <span></span><span></span>
      </button>
      <div class="nav-content" data-navigation>
        <div class="nav-links">
          <a href="#work">Work</a>
          <a href="#automation">Automation</a>
          <a href="#experience">Experience</a>
          <a href="#skills">Skills</a>
          <a href="#contact">Contact</a>
        </div>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme">
          <span class="theme-dot" aria-hidden="true"></span>
          <span data-theme-label>Light</span>
        </button>
      </div>
    </nav>
  </header>
  <button class="drawer-overlay" type="button" aria-label="Close navigation" tabindex="-1" data-drawer-overlay></button>
  <aside class="nav-drawer" id="mobile-navigation" aria-label="Mobile navigation" aria-hidden="true" inert data-navigation-drawer>
    <div class="drawer-header">
      <span class="drawer-label">Menu</span>
      <button class="drawer-close" type="button" aria-label="Close navigation" data-drawer-close>×</button>
    </div>
    <nav class="drawer-links" aria-label="Mobile navigation links">
      <a href="#work">Work</a>
      <a href="#automation">Automation</a>
      <a href="#experience">Experience</a>
      <a href="#skills">Skills</a>
      <a href="#contact">Contact</a>
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme">
      <span class="theme-dot" aria-hidden="true"></span>
      <span data-theme-label>Light</span>
    </button>
  </aside>
  <nav class="section-rail" aria-label="Page sections" data-section-rail hidden>
    <span class="section-rail-track" aria-hidden="true"><span class="section-rail-fill"></span></span>
    <div class="section-rail-items">
      <a class="section-rail-link is-current" href="#main" data-section-link="main" aria-current="true"><span class="section-rail-label">Home</span><span class="section-rail-dot"></span></a>
      <a class="section-rail-link" href="#work" data-section-link="work"><span class="section-rail-label">Projects</span><span class="section-rail-dot"></span></a>
      <a class="section-rail-link" href="#automation" data-section-link="automation"><span class="section-rail-label">Automation</span><span class="section-rail-dot"></span></a>
      <a class="section-rail-link" href="#experience" data-section-link="experience"><span class="section-rail-label">Experience</span><span class="section-rail-dot"></span></a>
      <a class="section-rail-link" href="#skills" data-section-link="skills"><span class="section-rail-label">Skills</span><span class="section-rail-dot"></span></a>
      <a class="section-rail-link" href="#education-title" data-section-link="education-title"><span class="section-rail-label">Education</span><span class="section-rail-dot"></span></a>
      <a class="section-rail-link" href="#contact" data-section-link="contact"><span class="section-rail-label">Contact</span><span class="section-rail-dot"></span></a>
    </div>
  </nav>

  <main id="main">
    <section class="hero content-width" aria-labelledby="hero-title">
      <div class="hero-main">
        <Image class="hero-portrait" src={profileImage} alt="Portrait of Gene Harold Cinto" loading="eager" {...imageDimensions(profileImage)} />
        <div class="hero-copy" data-reveal>
          <p class="eyebrow"><span class="eyebrow-mark"></span> <PopText id="hero-role" text="Web & automation developer" /></p>
          <PopText tag="h1" id="hero-title" text="Gene Harold Cinto" />
          <p class="hero-intro">
            Recent IT graduate from UC-Banilad who builds full-stack apps and AI-powered workflow automations.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="mailto:geneisme20@gmail.com">Email me <span aria-hidden="true">↗</span></a>
            <a class="text-link" href={`${base}Gene-Cinto-Resume.pdf`} target="_blank" rel="noopener">Resume<span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
      <aside class="hero-note" data-reveal aria-label="Portfolio introduction">
        <span class="note-index">01 / 03</span>
        <div class="note-rule"></div>
        <p>Good work starts with paying attention.</p>
        <span class="note-caption">Curiosity, care, and a bias for making.</span>
      </aside>
      <a class="scroll-cue" href="#work"><span class="scroll-arrow" aria-hidden="true">↓</span> Scroll down</a>
    </section>

    <section class="section work-section" id="work" aria-labelledby="work-title">
      <div class="content-width">
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow">Selected work <span class="section-count">01 — 03</span></p>
            <PopText tag="h2" id="work-title" text="A few things, made well." />
          </div>
          <p class="section-intro">Web, mobile, and client work built to solve practical problems.</p>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card" data-reveal>
              <div class="project-topline"><span>{project.number}</span><span class="project-arrow" aria-hidden="true">↗</span></div>
              <button class="project-cover-button" type="button" data-dialog-open={`project-dialog-${project.slug}`} aria-label={`Open ${project.title} project details`}>
                <span class:list={["project-cover", project.slug === "nimbus" && "project-cover--nimbus"]}>
                  {project.slug === "nimbus" ? (
                    <video class="project-cover-video" src={`${base}videos/nimbus-demo.mp4`} muted loop playsinline preload="none" poster={nimbusPoster.src} aria-label="Nimbus app demo, no audio" tabindex="-1"></video>
                  ) : project.cover ? (
                    <Image class:list={[project.slug === "blueprintpro" && "blueprintpro-cover-image"]} src={project.cover} alt={project.slug === "blueprintpro" ? "BlueprintPro web app preview" : ""} loading="lazy" format="webp" {...imageDimensions(project.cover)} />
                  ) : (
                    <span class="project-cover-placeholder">{project.title}</span>
                  )}
                </span>
                <span class="project-cover-caption">View project details <span aria-hidden="true">↗</span></span>
              </button>
              <div class="project-body">
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                {project.links && (
                  <div class="project-links">
                    {project.links.map((link) => (
                      <a href={link.href} target="_blank" rel="noopener">{link.label} <span aria-hidden="true">↗</span></a>
                    ))}
                  </div>
                )}
              </div>
              <ul class="tag-list" aria-label="Project disciplines">
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </article>
          ))}
        </div>
        {projects.map((project) => (
          <dialog class="portfolio-dialog project-dialog" id={`project-dialog-${project.slug}`} aria-labelledby={`project-title-${project.slug}`} data-accessible-dialog>
            <div class="dialog-content">
              <div class="dialog-header">
                <h2 id={`project-title-${project.slug}`}>{project.title}</h2>
                <button class="dialog-close" type="button" aria-label={`Close ${project.title} details`} data-dialog-close>×</button>
              </div>
              <p class="dialog-description">{project.description}</p>
              {project.slug === "blueprintpro" ? (
                <div class="project-gallery project-gallery--blueprintpro">
                  {project.gallery.map((image) => (
                    <figure>
                      <button class="blueprintpro-gallery-trigger" type="button" data-dialog-open="workflow-dialog-collect" data-blueprint-lightbox aria-label={`View full-size ${image.alt}`}>
                        <Image src={image.image} alt={image.alt} loading="lazy" format="webp" {...imageDimensions(image.image)} />
                      </button>
                    </figure>
                  ))}
                </div>
              ) : project.gallery.length > 0 ? (
                <div class:list={["project-gallery", project.slug === "nimbus" && "project-gallery--nimbus"]}>
                  {project.gallery.map((image) => (
                    <figure>
                      <Image src={image.image} alt={image.alt} loading="lazy" format="webp" {...imageDimensions(image.image, 1200)} />
                      <figcaption>{image.alt}</figcaption>
                    </figure>
                  ))}
                </div>
              ) : (
                <p class="gallery-empty">Project images will be added here.</p>
              )}
              <ul class="tag-list dialog-tags" aria-label={`${project.title} technologies`}>
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              {project.links && (
                <div class="dialog-links" aria-label={`${project.title} links`}>
                  {project.links.map((link) => <a href={link.href} target="_blank" rel="noopener">{link.label} <span aria-hidden="true">↗</span></a>)}
                </div>
              )}
            </div>
          </dialog>
        ))}
      </div>
    </section>

    <script>
      const blueprintLightbox = document.querySelector("#workflow-dialog-collect");
      let activeBlueprintTrigger;

      document.querySelectorAll("[data-blueprint-lightbox]").forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const thumbnail = trigger.querySelector("img");
          const lightboxImage = blueprintLightbox?.querySelector("img");
          const lightboxCaption = blueprintLightbox?.querySelector("figcaption");
          if (!thumbnail || !lightboxImage || !lightboxCaption) return;

          activeBlueprintTrigger = trigger;
          lightboxImage.src = thumbnail.currentSrc || thumbnail.src;
          lightboxImage.removeAttribute("srcset");
          lightboxImage.removeAttribute("sizes");
          lightboxImage.width = Number(thumbnail.getAttribute("width"));
          lightboxImage.height = Number(thumbnail.getAttribute("height"));
          lightboxImage.alt = thumbnail.alt;
          lightboxImage.loading = "eager";
          lightboxCaption.textContent = thumbnail.alt;
        }, { capture: true });
      });

      blueprintLightbox?.addEventListener("close", () => {
        const trigger = activeBlueprintTrigger;
        activeBlueprintTrigger = undefined;
        if (trigger) requestAnimationFrame(() => trigger.focus({ preventScroll: true }));
      }, { capture: true });

      const nimbusVideo = document.querySelector(".project-cover-video");
      const reduceNimbusMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (nimbusVideo instanceof HTMLVideoElement && !reduceNimbusMotion && "IntersectionObserver" in window) {
        const nimbusObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const video = entry.target;
              if (entry.isIntersecting) {
                video.muted = true;
                video.play().catch(() => {});
              } else {
                video.pause();
              }
            });
          },
          { threshold: 0.5 },
        );
        nimbusObserver.observe(nimbusVideo);
      }
    </script>

    <section class="section automation-section" id="automation" aria-labelledby="automation-title">
      <div class="content-width automation-layout">
        <div class="automation-heading" data-reveal>
          <p class="eyebrow">Built and used during my internship at StellarPH, 2026</p>
          <PopText tag="h2" id="automation-title" text="StartupNews.ph article pipeline" />
          <p class="section-intro">An end-to-end n8n pipeline I built and ran during my internship at StellarPH (2026). It found Philippine and Southeast Asian startup news, scored it, picked the best story, and drafted an SEO-optimized article with a cover image for a human editor to review and publish.</p>
        </div>
        <div class="automation-list">
          <div class="automation-metrics" aria-label="Pipeline metrics">
            {automationMetrics.map((metric) => (
              <div class="automation-metric"><strong>{metric.value}</strong><span>{metric.label}</span></div>
            ))}
          </div>
          <div class="automation-flow" aria-label="Four-step article workflow">
            {automation.map((item, index) => (
              <article class="automation-item" data-reveal>
                <span class="list-index" aria-label={`Step ${index + 1}`}>0{index + 1}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <button class="workflow-image-button" type="button" data-dialog-open={`workflow-dialog-${item.slug}`} aria-label={`Enlarge ${item.title} workflow screenshot`}>
                  <Image src={item.image} alt={item.imageAlt} loading="lazy" format="webp" {...imageDimensions(item.image, 1200)} />
                  <span>n8n workflow, click to enlarge</span>
                </button>
                <ul class="tag-list automation-tags" aria-label={`${item.title} technologies`}>
                  {item.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </article>
            ))}
          </div>
          <div class="design-decisions" data-reveal>
            <h3>Design decisions</h3>
            <ol class="decision-list">
              {automationDecisions.map((decision) => <li>{decision}</li>)}
            </ol>
          </div>
          <section class="pipeline-articles" aria-labelledby="pipeline-articles-title">
            <div class="pipeline-articles-head">
              <div class="pipeline-articles-text">
                <h3 class="eyebrow" id="pipeline-articles-title">Articles from the pipeline</h3>
                <p class="pipeline-articles-intro">Articles produced by the pipeline and published on StartupNews.ph during my internship. Summaries below are AI-generated.</p>
              </div>
              <div class="article-scroll-buttons" data-article-scroll-buttons hidden>
                <button class="article-scroll-button" type="button" aria-label="Previous articles" aria-controls="pipeline-article-scroller" data-article-previous disabled><span aria-hidden="true">←</span></button>
                <button class="article-scroll-button" type="button" aria-label="Next articles" aria-controls="pipeline-article-scroller" data-article-next disabled><span aria-hidden="true">→</span></button>
              </div>
            </div>
            <div class="articles-scroller" id="pipeline-article-scroller" data-article-scroller role="region" aria-label="Pipeline articles, scroll horizontally">
              {pipelineArticles.map((article) => (
                <article class="article-card" data-reveal data-article-card>
                  <span class="article-category">{article.category}</span>
                  <h3>{article.title}</h3>
                  <p class="article-summary">{article.summary}</p>
                  <a class="article-link" href={article.url} target="_blank" rel="noopener noreferrer" aria-label={`Read "${article.title}" on StartupNews.ph`}>
                    Read on StartupNews.ph <span aria-hidden="true">↗</span>
                  </a>
                </article>
              ))}
            </div>
            <div class="article-scrollbar" data-article-scrollbar aria-hidden="true" hidden>
              <span class="pipeline-progress-track"></span>
              <span class="pipeline-progress-node"></span>
              <div class="pipeline-stations">
                <span class="pipeline-station" data-station-position="0"><span class="pipeline-station-dot"></span><span class="pipeline-station-label"></span></span>
                <span class="pipeline-station" data-station-position="33.3"><span class="pipeline-station-label"></span></span>
                <span class="pipeline-station" data-station-position="66.6"><span class="pipeline-station-label"></span></span>
                <span class="pipeline-station" data-station-position="100"><span class="pipeline-station-dot"></span><span class="pipeline-station-label"></span></span>
              </div>
            </div>
          </section>
          {automation.map((item) => (
            <dialog class="workflow-lightbox" id={`workflow-dialog-${item.slug}`} aria-labelledby={`workflow-caption-${item.slug}`} data-accessible-dialog>
              <button class="dialog-close" type="button" aria-label={`Close ${item.title} workflow image`} data-dialog-close>×</button>
              <figure>
                <Image src={item.image} alt={item.imageAlt} loading="lazy" format="webp" {...imageDimensions(item.image)} />
                <figcaption id={`workflow-caption-${item.slug}`}>{item.imageAlt}</figcaption>
              </figure>
            </dialog>
          ))}
        </div>
      </div>
    </section>

    <section class="section experience-section" id="experience" aria-labelledby="experience-title">
      <div class="content-width">
        <div class="section-heading" data-reveal>
          <div><p class="eyebrow">The path so far</p><PopText tag="h2" id="experience-title" text="Experience" /></div>
          <p class="section-intro">IT and web development experience across automation, publishing, and client sites.</p>
        </div>
        <div class="experience-list">
          {experience.map((item) => (
            <article class="experience-row" data-reveal>
              <p class="experience-date">{item.dates}</p>
              <div class="experience-role"><h3>{item.role}</h3><p>{item.company}</p></div>
              <p class="experience-description">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section about-section" id="skills" aria-labelledby="skills-title">
      <div class="content-width about-layout">
        <div class="about-heading" data-reveal><p class="eyebrow">Tools and strengths</p><PopText tag="h2" id="skills-title" text="Skills" /></div>
        <div class="about-content" data-reveal>
          <div class="skills-grid">
            {skills.map((group) => (
              <div class="skill-group"><h3>{group.category}</h3><ul>{group.items.map((skill) => <li>{skill}</li>)}</ul></div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section education-section" aria-labelledby="education-title">
      <div class="content-width education-layout" data-reveal>
        <div><p class="eyebrow">Foundations</p><PopText tag="h2" id="education-title" text="Education" /></div>
        <div class="education-list">
          {education.map((item) => (
            <article class="education-row"><div><span class="experience-date">{item.level}</span><h3>{item.qualification}</h3><p>{item.institution}</p></div><p class="experience-date">{item.dates}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="content-width contact-inner" data-reveal>
        <p class="eyebrow">Have something good in mind?</p>
        <h2 id="contact-title"><PopText text="Let’s make it" /><br /><span class="contact-heading-accent"><PopText text="matter." /></span></h2>
        <p class="contact-copy">I’m always glad to meet thoughtful people working on useful things.</p>
        <a class="button button-light" href="mailto:geneisme20@gmail.com">Email me <span aria-hidden="true">↗</span></a>
        <div class="contact-links" aria-label="Contact profiles">
          <a href="mailto:geneisme20@gmail.com">geneisme20@gmail.com</a>
          <a href="https://linkedin.com/in/genecinto" target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
          <a href="https://github.com/JinniHarold" target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <span class="contact-index" aria-hidden="true">GH / 2026</span>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="content-width footer-inner">
      <a class="wordmark footer-wordmark" href={`${base}`} aria-label="Gene Harold Cinto, home">Gene<span>.</span></a>
      <p>Open to junior web and automation roles. <a href="mailto:geneisme20@gmail.com">Say hello</a> <span>© 2026 Gene Harold Cinto</span></p>
      <a class="back-to-top" href="#main">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </footer>
</BaseLayout>
---
import BaseLayout from "../layouts/BaseLayout.astro";
import { automation, education, experience, projects, skills } from "../data/portfolio.js";

const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <nav class="nav-shell" aria-label="Main navigation">
      <a class="wordmark" href={`${base}`} aria-label="Gene Harold, home">GH<span>.</span></a>
      <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" data-menu-toggle>
        <span></span><span></span>
      </button>
      <div class="nav-content" data-navigation>
        <div class="nav-links">
          <a href="#work">Work</a>
          <a href="#automation">Automation</a>
          <a href="#experience">Experience</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </div>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme">
          <span class="theme-dot" aria-hidden="true"></span>
          <span data-theme-label>Light</span>
        </button>
      </div>
    </nav>
  </header>

  <main id="main">
    <section class="hero content-width" aria-labelledby="hero-title">
      <div class="hero-copy" data-reveal>
        <p class="eyebrow"><span class="eyebrow-mark"></span> Portfolio / 2026</p>
        <h1 id="hero-title">Thoughtful work.<br /><span>Useful by design.</span></h1>
        <p class="hero-intro">
          I’m Gene, a <span class="placeholder">[your role]</span> who turns complex problems into clear digital experiences and calmer ways of working.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">Explore selected work <span aria-hidden="true">↘</span></a>
          <a class="text-link" href="#contact">Get in touch <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="hero-note" data-reveal aria-label="Portfolio introduction">
        <span class="note-index">01 / 04</span>
        <div class="note-rule"></div>
        <p>Good work starts with paying attention.</p>
        <span class="note-caption">Curiosity, care, and a bias for making.</span>
      </aside>
      <a class="scroll-cue" href="#work"><span class="scroll-line"></span> Scroll to explore</a>
    </section>

    <section class="section work-section" id="work" aria-labelledby="work-title">
      <div class="content-width">
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow">Selected work <span class="section-count">01 — 03</span></p>
            <h2 id="work-title">A few things, made well.</h2>
          </div>
          <p class="section-intro">A selection of projects that bring useful ideas into the real world.</p>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card" data-reveal>
              <div class="project-topline"><span>{project.number}</span><span class="project-arrow" aria-hidden="true">↗</span></div>
              <div class="project-body">
                <h3><a href={project.href}>{project.title}</a></h3>
                <p>{project.description}</p>
              </div>
              <ul class="tag-list" aria-label="Project disciplines">
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section automation-section" id="automation" aria-labelledby="automation-title">
      <div class="content-width automation-layout">
        <div class="automation-heading" data-reveal>
          <p class="eyebrow">Less busywork / more good work</p>
          <h2 id="automation-title">Make the useful things happen automatically.</h2>
          <p class="section-intro">Small, considered systems can give people more room to do their best work.</p>
        </div>
        <div class="automation-list">
          {automation.map((item, index) => (
            <article class="automation-item" data-reveal>
              <span class="list-index">0{index + 1}</span>
              <div><h3>{item.title}</h3><p>{item.description}</p></div>
              <span class="item-arrow" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section experience-section" id="experience" aria-labelledby="experience-title">
      <div class="content-width">
        <div class="section-heading" data-reveal>
          <div><p class="eyebrow">The path so far</p><h2 id="experience-title">Experience</h2></div>
          <p class="section-intro">A little context on where I’ve been and what I’ve learned along the way.</p>
        </div>
        <div class="experience-list">
          {experience.map((item) => (
            <article class="experience-row" data-reveal>
              <p class="experience-date">{item.dates}</p>
              <div class="experience-role"><h3>{item.role}</h3><p>{item.company}</p></div>
              <p class="experience-description">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section about-section" id="about" aria-labelledby="about-title">
      <div class="content-width about-layout">
        <div class="about-heading" data-reveal><p class="eyebrow">A little about me</p><h2 id="about-title">Curious by nature.<br />Practical by choice.</h2></div>
        <div class="about-content" data-reveal>
          <p class="about-lead">I care about the details, the people on the other side of the screen, and what happens after an idea ships.</p>
          <p>This is a placeholder for a more personal introduction: the perspective you bring, the problems you like to solve, and the kind of work you want to do more of.</p>
          <div class="skills-grid">
            {skills.map((group) => (
              <div class="skill-group"><h3>{group.category}</h3><ul>{group.items.map((skill) => <li>{skill}</li>)}</ul></div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section education-section" aria-labelledby="education-title">
      <div class="content-width education-layout" data-reveal>
        <div><p class="eyebrow">Foundations</p><h2 id="education-title">Education</h2></div>
        <div class="education-list">
          {education.map((item) => (
            <article class="education-row"><div><h3>{item.qualification}</h3><p>{item.institution}</p></div><p class="experience-date">{item.dates}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="content-width contact-inner" data-reveal>
        <p class="eyebrow">Have something good in mind?</p>
        <h2 id="contact-title">Let’s make it<br /><span>matter.</span></h2>
        <p class="contact-copy">I’m always glad to meet thoughtful people working on useful things.</p>
        <a class="button button-light" href="mailto:hello@example.com">Say hello <span aria-hidden="true">↗</span></a>
        <span class="contact-index" aria-hidden="true">GH / 2026</span>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="content-width footer-inner">
      <a class="wordmark footer-wordmark" href={`${base}`} aria-label="Gene Harold, home">GH<span>.</span></a>
      <p>Made with intention. <span>© 2026 Gene Harold</span></p>
      <a class="back-to-top" href="#main">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </footer>
</BaseLayout>